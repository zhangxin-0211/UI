# Qt Creator user settings and build output
.qtcreator/
build*/
b-msvc/
build-camera-*/

# Deployed runtime package; generate from the Release build when needed
dist/

# Python cache generated by theme-preview utilities
__pycache__/
*.py[cod]

# Qt build artifacts
Makefile*
object_script.*
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.o
*.obj
*.exe

# OpenCV runtime binaries are copied locally after build. The debug DLL is
# larger than GitHub's normal single-file limit and must not be committed.
third_party/opencv/x64/vc15/bin/*.dll
third_party/opencv/x64/vc15/bin/*.pdb

# Local map authorization: never commit API credentials or provider URLs.
amap.local.ini
