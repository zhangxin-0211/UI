# Qt Creator user settings and build output
.qtcreator/
build*/
b-msvc/
build-camera-*/

# Deployed runtime package; generate from the Release build when needed
dist/

# Python cache generated by theme-preview utilities
__pycache__/
*.py[cod]

# Qt build artifacts
Makefile*
object_script.*
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.o
*.obj
*.exe

# OpenCV runtime binaries are copied locally after build. The debug DLL is
# larger than GitHub's normal single-file limit and must not be committed.
third_party/opencv/x64/vc15/bin/*.dll
third_party/opencv/x64/vc15/bin/*.pdb

# Local map authorization: never commit API credentials or provider URLs.
amap.local.ini


# Local temporary files and generated packages
.artifact-work/
.qmake.stash
debug/
release/
installer/
outputs/
*.dll
*.pdb
*.pro.user
CSV/
*_recognition_result.png


# 保留 Release 编译和运行需要的 OpenCV 文件
third_party/opencv/x64/vc15/bin/*
!third_party/opencv/x64/vc15/bin/opencv_world453.dll
!third_party/opencv/x64/vc15/bin/opencv_videoio_msmf453_64.dll
!third_party/opencv/x64/vc15/bin/opencv_videoio_ffmpeg453_64.dll

third_party/opencv/x64/vc15/lib/*
!third_party/opencv/x64/vc15/lib/opencv_world453.lib
tests/target_wrapper.bat